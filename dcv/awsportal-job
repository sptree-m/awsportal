#!/usr/bin/env python3
"""Register and run a job in the caller's measured systemd user scope."""
import json
import os
import re
import socket
import subprocess
import sys
import uuid

def notify(payload):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(20)
        client.connect("/run/awsportal-dcv/jobs.sock")
        client.sendall(json.dumps(payload).encode() + b"\n")
        response = client.makefile("rb").readline(4096)
        if json.loads(response).get("ok") is not True:
            raise RuntimeError("job ledger rejected the request")


def main():
    if not 200001 <= os.geteuid() <= 1200000:
        raise SystemExit("Run this from your awsportal desktop account")
    args = sys.argv[1:]
    if args and args[0] == "--worker":
        if len(args) < 3 or not re.fullmatch(r"[a-f0-9]{32}", args[1]):
            raise SystemExit("invalid worker identity")
        job_id, command = args[1], args[2:]
        # Do not start unregistered work if the collector is unavailable.
        notify({"event": "start", "job_id": job_id})
        try:
            code = subprocess.call(command)
        except OSError:
            code = 127
        try:
            notify({"event": "finish", "job_id": job_id, "exit_code": code})
        except Exception:
            print("Job exit was not acknowledged; collector retains its last observation.", file=sys.stderr)
        raise SystemExit(code if code >= 0 else 128 - code)
    if not args:
        raise SystemExit("Usage: awsportal-job COMMAND [ARG ...]")
    job_id = uuid.uuid4().hex
    os.execv("/usr/bin/systemd-run", ["systemd-run", "--user", "--scope", "--quiet",
             "--property=CPUAccounting=yes", "--property=MemoryAccounting=yes", "--property=IOAccounting=yes",
             "--unit=awsportal-job-" + job_id, "--", os.path.realpath(__file__), "--worker", job_id] + args)


if __name__ == "__main__":
    main()
